+                                else
+                                {
+                                    enabled_tick = xTaskGetTickCount();
+                                    enabled_cycle = DWT->CYCCNT;
+                                    s_diagnostics.mode = CONTROL_PRIMING;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            else
+            {
+                bool primed = ((TickType_t)(sample_now - enabled_tick) >= CONTROL_PRIMING_TICKS) &&
