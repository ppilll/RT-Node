+            if (key1) { if (key1_down < 2U) { key1_down++; } }
+            else { key1_down = 0U; }
+
+            /* Input failure has priority over a coincident normal stop. */
+            if ((available && imu.state == IMU_FAILED) || (session.authorized && !ready))
